---
import "../styles/global.css";
import "../styles/cinematic.css";
import "../styles/narrative.css";
import "../styles/interface.css";
import ArrowIcon from "../components/ArrowIcon.astro";

const artwork = {
  hero: "/images/gears-hero.webp",
  keyart:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/gears-of-war-keyart-69d6e5931386b-2048x1152.jpg",
  locust:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/gears-1-multiplayer-69d6ea471c35a.jpg",
  squad:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/gears-1-co-op-69d6e9d002b82.jpg",
  lancer:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_02-69dd6f1b3403f-1024x576.jpg",
  ruins:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_Estate-69dd6f0ddae56-1024x576.jpg",
  finale:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_01op-69dd73f95d325-1024x576.jpg",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta
      name="description"
      content="La última línea de defensa de la humanidad. Revive el origen de Gears of War."
    />
    <title>Gears of War — Emerge de las cenizas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="ember-field" aria-hidden="true"></canvas>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="#inicio" aria-label="Gears of War, inicio">
          <span class="brand-mark">
            <img src="/images/gears-cog.png" alt="" width="332" height="400" />
          </span>
          <span class="brand-copy">GEARS<span>OF WAR</span></span>
        </a>

        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#historia">La historia</a>
          <a href="#personajes">Personajes</a>
          <a href="#arsenal">El arsenal</a>
        </nav>

        <span class="page-progress" aria-hidden="true">
          <span class="page-progress-fill"></span>
        </span>

        <details class="mobile-menu">
          <summary aria-label="Abrir menú" aria-expanded="false">
            <span></span><span></span>
          </summary>
          <nav aria-label="Navegación móvil">
            <a href="#historia">La historia</a>
            <a href="#personajes">Personajes</a>
            <a href="#arsenal">El arsenal</a>
            <a href="https://www.gearsofwar.com/en-us/" target="_blank" rel="noreferrer">
              Sitio oficial <span class="interface-icon"><ArrowIcon /></span>
            </a>
          </nav>
        </details>

        <a
          class="topbar-cta"
          href="https://www.gearsofwar.com/en-us/"
          target="_blank"
          rel="noreferrer"
        >
          SITIO OFICIAL <span class="interface-icon"><ArrowIcon /></span>
        </a>
      </header>

      <main>
        <section class="hero" id="inicio" aria-labelledby="hero-title">
          <div class="hero-art" aria-hidden="true">
            <img
              src={artwork.hero}
              alt=""
              fetchpriority="high"
              width="1024"
              height="487"
              decoding="async"
            />
            <div class="hero-art-shade"></div>
            <div class="hero-art-grain"></div>
            <div class="hero-coordinate">
              <span>IMULSION DETECTADA</span>
              <span class="coordinate-dot"></span>
              <span>31° 46' N — 106° 29' W</span>
            </div>
            <div class="art-frame art-frame-top"></div>
            <div class="art-frame art-frame-bottom"></div>
          </div>

          <div class="hero-copy">
            <p class="eyebrow"><span></span> LA ÚLTIMA LÍNEA DE DEFENSA</p>
            <h1 id="hero-title">
              EMERGE<br />
              <span>DE LAS</span><br />
              <span class="title-accent">CENIZAS.</span>
            </h1>
            <div class="hero-detail">
              <span class="detail-rule"></span>
              <p>
                Sera cayó.<br />
                La humanidad resistió.<br />
                <strong>La guerra apenas comienza.</strong>
              </p>
            </div>
            <div class="hero-actions">
              <a class="button button-primary" href="#guerra">
                <span>ENTRA EN SERA</span>
                <ArrowIcon direction="south-east" class="button-icon" />
              </a>
              <a
                class="button button-ghost"
                href="https://www.gearsofwar.com/en-us/games/gears-of-war/"
                target="_blank"
                rel="noreferrer"
              >
                <ArrowIcon class="play-icon" />
                SITIO OFICIAL
              </a>
            </div>
          </div>

          <div class="hero-stamp" aria-label="Delta Squad">
            <span>DELTA</span>
            <span class="stamp-center">D-01</span>
            <span>STAND TOGETHER</span>
          </div>

          <div class="hero-index" aria-hidden="true">
            <span>01</span>
            <span class="index-line"></span>
            <span>06</span>
          </div>

          <a class="scroll-cue" href="#guerra">
            <span>DESCIENDE A LA BATALLA</span>
            <span class="scroll-arrow"><ArrowIcon direction="down" /></span>
          </a>
        </section>

        <section class="war-sequence" id="guerra" aria-label="La guerra de Sera">
          <div class="sequence-frame">
            <div class="sequence-progress" aria-hidden="true">
              <span class="sequence-progress-fill"></span>
            </div>
            <div class="sequence-counter" aria-hidden="true">
              <span class="sequence-current">01</span><i>/</i>06
            </div>
            <article
              class="sequence-scene scene-awakening"
              data-scene="01"
              data-visual="panorama"
              aria-labelledby="scene-awakening-title"
            >
              <img
                class="scene-image"
                src={artwork.ruins}
                alt="Fortificaciones y ruinas de Sera en una captura promocional oficial"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> SERA // DÍA DE LA EMERGENCIA</p>
                <h2 id="scene-awakening-title">EL MUNDO<br />SE <em>QUEBRÓ.</em></h2>
                <p>De las entrañas de Sera surgió la Horda Locust. La civilización tenía las horas contadas.</p>
                <a class="text-link" href="https://www.gearsofwar.com/en-us/games/gears-of-war/" target="_blank" rel="noreferrer">
                  ARCHIVO DE LA GUERRA <span class="interface-icon"><ArrowIcon /></span>
                </a>
              </div>
              <span class="scene-coordinate" aria-hidden="true">31°46'N // EMERGENCIA</span>
            </article>
            <article
              class="sequence-scene scene-locust"
              data-scene="02"
              data-visual="breach"
              aria-labelledby="scene-locust-title"
            >
              <img
                class="scene-image"
                src={artwork.locust}
                alt="Combate entre la CGO y la Horda Locust"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> CONTACTO HOSTIL // LOCUST</p>
                <h2 id="scene-locust-title">BAJO TIERRA.<br /><em>EN TODAS PARTES.</em></h2>
                <p>No conocen el miedo. No negocian. Y no dejarán de venir.</p>
                <span class="scene-tag">AMENAZA: EXTINCIÓN</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">CONTACTO VISUAL // ABRAN FUEGO</span>
            </article>
            <article
              class="sequence-scene scene-squad"
              data-scene="03"
              data-visual="formation"
              id="escuadron"
              aria-labelledby="scene-squad-title"
            >
              <img
                class="scene-image"
                src={artwork.squad}
                alt="Delta Squad: Marcus Fenix, Dominic Santiago, Augustus Cole y Damon Baird"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> CGO // ESCUADRÓN DELTA</p>
                <h2 id="scene-squad-title">CUATRO SOLDADOS.<br /><em>UNA HUMANIDAD.</em></h2>
                <p>Fenix. Santiago. Cole. Baird. Cuando cae el mundo, nadie lucha solo.</p>
                <div class="squad-roster" aria-label="Integrantes de Delta Squad">
                  <span>MARCUS FENIX</span><span>DOM SANTIAGO</span>
                  <span>AUGUSTUS COLE</span><span>DAMON BAIRD</span>
                </div>
              </div>
              <span class="scene-coordinate" aria-hidden="true">SQUAD STATUS // READY</span>
            </article>
            <article
              class="sequence-scene scene-arsenal"
              data-scene="04"
              data-visual="armory"
              aria-labelledby="scene-arsenal-title"
            >
              <img
                class="scene-image"
                src={artwork.lancer}
                alt="Marcus Fenix armado con un rifle de asalto Lancer"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> CGO // ARMAMENTO ESTÁNDAR</p>
                <h2 id="scene-arsenal-title">UN LANCER.<br /><em>ÚLTIMA PALABRA.</em></h2>
                <p>Acero, pólvora y una bayoneta sierra. El sonido de Sera resistiendo.</p>
                <span class="scene-tag">MK 2 LANCER // LISTO PARA EL COMBATE</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">MANTENER POSICIÓN // RECARGAR</span>
            </article>
            <article
              class="sequence-scene scene-ruins"
              data-scene="05"
              data-visual="ashfall"
              aria-labelledby="scene-ruins-title"
            >
              <img
                class="scene-image"
                src={artwork.ruins}
                alt="Ruinas y fortificaciones en el planeta Sera"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> SERA // MUNDO EN RUINAS</p>
                <h2 id="scene-ruins-title">TODO LO QUE<br />QUEDA ES <em>LUCHAR.</em></h2>
                <p>Calles vacías. Ciudades caídas. Una última oportunidad para salvar lo que queda.</p>
                <span class="scene-tag">NO HAY REFUERZOS // MANTÉN LA LÍNEA</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">FENIX ESTATE // SECTOR 04</span>
            </article>
            <article
              class="sequence-scene scene-finale"
              data-scene="06"
              data-visual="last-stand"
              aria-labelledby="scene-finale-title"
            >
              <img
                class="scene-image"
                src={artwork.finale}
                alt="Delta Squad listo para la última misión"
                width="1024"
                height="576"
                loading="lazy"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> ESTA ES NUESTRA ÚLTIMA LÍNEA</p>
                <h2 id="scene-finale-title">NO NOS<br /><em>RENDIMOS.</em></h2>
                <p>La humanidad todavía respira. Haz que cada bala cuente.</p>
                <a class="button button-primary" href="https://www.gearsofwar.com/en-us/games/gears-of-war/" target="_blank" rel="noreferrer">
                  <span>DESCUBRE GEARS OF WAR</span>
                  <ArrowIcon class="button-icon" />
                </a>
              </div>
              <span class="scene-coordinate" aria-hidden="true">DELTA OUT // STAY ALIVE</span>
            </article>
            <nav class="sequence-nav" aria-label="Escenas de la campaña">
              <a href="#guerra" data-scene-link="0" aria-label="Escena 1: El despertar" aria-current="step">01</a>
              <a href="#guerra" data-scene-link="1" aria-label="Escena 2: La amenaza Locust">02</a>
              <a href="#guerra" data-scene-link="2" aria-label="Escena 3: Delta Squad">03</a>
              <a href="#guerra" data-scene-link="3" aria-label="Escena 4: El arsenal">04</a>
              <a href="#guerra" data-scene-link="4" aria-label="Escena 5: Sera en ruinas">05</a>
              <a href="#guerra" data-scene-link="5" aria-label="Escena 6: La última línea">06</a>
            </nav>
            <span class="sequence-hint" aria-hidden="true">DESPLÁZATE PARA AVANZAR</span>
          </div>
        </section>

        <section class="character-section" id="personajes" aria-labelledby="characters-title">
          <header class="editorial-heading section-wrap reveal">
            <p class="eyebrow"><span></span> CGO // ARCHIVO DEL ESCUADRÓN</p>
            <h2 id="characters-title">LOS QUE<br /><em>NO CEDEN.</em></h2>
            <p>
              No son leyendas porque no tengan miedo. Lo son porque siguen avanzando juntos.
            </p>
          </header>

          <div class="character-track" data-editorial-track>
            <div class="character-stage" data-editorial-stage>
              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="command"
                aria-labelledby="character-marcus-title"
              >
                <img
                  class="editorial-image"
                  src={artwork.hero}
                  alt="Marcus Fenix y Dominic Santiago en el arte local del hero, frente a las ruinas de Sera"
                  width="1024"
                  height="487"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> SOLDADO // COG</p>
                  <h3 id="character-marcus-title">MARCUS<br /><em>FENIX.</em></h3>
                  <p>
                    Un veterano endurecido que regresa al servicio cuando la humanidad está al
                    borde del colapso. Al frente de Delta, su instinto de supervivencia se convierte
                    en el centro de una misión imposible.
                  </p>
                  <span class="editorial-caption">ARCHIVO VISUAL // MARCUS Y DOM EN SERA</span>
                </div>
                <span class="editorial-coordinate">01 // EL LÍDER</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="brotherhood"
                aria-labelledby="character-dom-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.squad}
                  alt="Dominic Santiago y Delta en una captura promocional oficial de campaña"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> SOLDADO // DELTA</p>
                  <h3 id="character-dom-title">DOMINIC<br /><em>SANTIAGO.</em></h3>
                  <p>
                    Leal, cercano a Marcus desde antes de la guerra y siempre dispuesto a cubrirle
                    la espalda. Dom es el vínculo humano que mantiene unido al escuadrón en medio
                    del combate.
                  </p>
                  <span class="editorial-caption">ARCHIVO VISUAL // HERMANOS DE ARMAS</span>
                </div>
                <span class="editorial-coordinate">02 // EL COMPAÑERO</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="thrashball"
                aria-labelledby="character-cole-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.squad}
                  alt="Imagen promocional oficial del Escuadrón Delta reunido"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> SOLDADO // DELTA</p>
                  <h3 id="character-cole-title">AUGUSTUS<br /><em>COLE.</em></h3>
                  <p>
                    Cole Train aporta energía y fuerza a Delta. Antes de combatir por la CGO fue
                    una estrella del thrashball; su espíritu competitivo sigue vivo incluso en la
                    batalla.
                  </p>
                  <span class="editorial-caption">ARCHIVO VISUAL // ESCUADRÓN DELTA</span>
                </div>
                <span class="editorial-coordinate">03 // COLE TRAIN</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="tactician"
                aria-labelledby="character-baird-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.squad}
                  alt="Imagen promocional oficial del Escuadrón Delta reunido"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> INGENIERO // DELTA</p>
                  <h3 id="character-baird-title">DAMON<br /><em>BAIRD.</em></h3>
                  <p>
                    Técnico brillante y pragmático. Su conocimiento de los sistemas de la CGO
                    resuelve problemas que no se solucionan con fuerza bruta, aunque nunca pierda
                    la oportunidad de lanzar una réplica.
                  </p>
                  <span class="editorial-caption">ARCHIVO VISUAL // ESCUADRÓN DELTA</span>
                </div>
                <span class="editorial-coordinate">04 // EL INGENIERO</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="command-comms"
                aria-labelledby="character-anya-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image editorial-image--comms"
                  src={artwork.ruins}
                  alt="Escenario de Sera de una captura promocional oficial; Anya apoya a Delta por comunicaciones"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> COMUNICACIONES // CGO</p>
                  <h3 id="character-anya-title">ANYA<br /><em>STROUD.</em></h3>
                  <p>
                    Desde el centro de mando, Anya mantiene el enlace entre Delta y la CGO.
                    Inteligencia, órdenes y orientación convierten su voz en parte esencial de la
                    operación.
                  </p>
                  <span class="editorial-caption">ARCHIVO DE CAMPAÑA // APOYO POR RADIO</span>
                </div>
                <span class="editorial-coordinate">05 // LA VOZ EN EL FRENTE</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="horde"
                aria-labelledby="character-locust-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.locust}
                  alt="Combate entre soldados de la CGO y la amenaza Locust en una imagen promocional oficial"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> ENEMIGO // EL HOLLOW</p>
                  <h3 id="character-locust-title">LA HORDA<br /><em>LOCUST.</em></h3>
                  <p>
                    Una fuerza que emerge de las profundidades y golpea a la humanidad en el Día
                    de la Emergencia. Su avance transforma cada ciudad en una línea de defensa.
                  </p>
                  <span class="editorial-caption">ARCHIVO VISUAL // CONTACTO HOSTIL</span>
                </div>
                <span class="editorial-coordinate">06 // BAJO TIERRA</span>
              </article>

              <nav class="editorial-nav" aria-label="Archivo de personajes">
                <a href="#personajes" data-editorial-link="0" aria-label="Marcus Fenix" aria-current="step">01</a>
                <a href="#personajes" data-editorial-link="1" aria-label="Dominic Santiago">02</a>
                <a href="#personajes" data-editorial-link="2" aria-label="Augustus Cole">03</a>
                <a href="#personajes" data-editorial-link="3" aria-label="Damon Baird">04</a>
                <a href="#personajes" data-editorial-link="4" aria-label="Anya Stroud">05</a>
                <a href="#personajes" data-editorial-link="5" aria-label="La Horda Locust">06</a>
              </nav>
              <div class="editorial-counter" aria-hidden="true">
                <span data-editorial-current>01</span><i>/</i>06
              </div>
              <span class="editorial-hint" aria-hidden="true">DESPLÁZATE PARA CONOCERLOS</span>
            </div>
          </div>
        </section>

        <section class="chronicle-section" id="historia" aria-labelledby="chronicle-title">
          <header class="editorial-heading section-wrap reveal">
            <p class="eyebrow"><span></span> ARCHIVOS DE LA CGO // CAMPAÑA ORIGINAL</p>
            <h2 id="chronicle-title">EL DÍA QUE<br /><em>TODO CAMBIÓ.</em></h2>
            <p>
              Seis capítulos del primer Gears of War: el colapso de Sera, la misión de Delta y el
              precio de resistir.
            </p>
          </header>

          <details class="spoiler-disclosure">
            <summary>
              <span class="spoiler-mark" aria-hidden="true">!</span>
              <span>
                <strong>La campaña contiene spoilers</strong>
                <small>Abre el archivo para continuar con la historia del juego original.</small>
              </span>
              <span class="spoiler-toggle" aria-hidden="true">+</span>
            </summary>

            <div class="chronicle-track" data-editorial-track>
              <div class="chronicle-stage" data-editorial-stage>
                <article
                  class="editorial-panel chronicle-panel"
                  data-editorial-slide
                  data-visual="aftermath"
                  aria-labelledby="chapter-one-title"
                >
                  <img
                    class="editorial-image"
                    src={artwork.ruins}
                    alt="Arquitectura y fortificaciones de Sera en una captura promocional oficial"
                    width="1024"
                    height="576"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="editorial-wash"></div>
                  <div class="editorial-copy">
                    <p class="eyebrow"><span></span> CAPÍTULO 01 // ANTES DEL DÍA E</p>
                    <h3 id="chapter-one-title">UN MUNDO<br /><em>AGOTADO.</em></h3>
                    <p>
                      Las Guerras del Péndulo dejaron a Sera marcada por décadas de conflicto.
                      La Imulsión prometió energía y prosperidad, pero su valor estratégico volvió
                      a enfrentar a las naciones por el control de un recurso decisivo.
                    </p>
                    <span class="editorial-caption">SERA // HERENCIA DE LAS GUERRAS HUMANAS</span>
                  </div>
                  <span class="editorial-coordinate">01 // EL MUNDO ANTES DE LA EMERGENCIA</span>
                </article>

                <article
                  class="editorial-panel chronicle-panel"
                  data-editorial-slide
                  data-visual="breach"
                  aria-labelledby="chapter-two-title"
                  aria-hidden="true"
                >
                  <img
                    class="editorial-image"
                    src={artwork.locust}
                    alt="Combate entre tropas de la CGO y Locust en una imagen promocional oficial"
