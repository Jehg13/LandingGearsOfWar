---
import "../styles/global.css";
import "../styles/cinematic.css";
import "../styles/narrative.css";
import "../styles/interface.css";
import "../styles/catalog.css";
import ArrowIcon from "../components/ArrowIcon.astro";
import ArmorySection from "../components/ArmorySection.astro";
import ThreatDatabaseSection from "../components/ThreatDatabaseSection.astro";

const artwork = {
  hero:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/05/01_GoW_EDAY_StoryofEmergence_Final-6a1766321388d-2048x1152.jpg",
  locust:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/05/06_GoW_EDAY_Drone_Final-6a176650a8f1a-2048x1152.jpg",
  squad:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/05/02_GoW_EDAY_BravoSquad_Final-6a176637d1a6c-2048x1152.jpg",
  combat:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/06/09_GoW_EDAY_DroneStruggle_Final-6a21e32f4f748-2048x1152-6a288c43344ca.jpg",
  lancer:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_02-69dd6f1b3403f-1024x576.jpg",
  ruins:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/06/11_GoW_EDAY_CentralSquare_Final-6a21e3d35afa2-2048x1152-6a288c6496d66.jpg",
  estate:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_Estate-69dd6f0ddae56-1024x576.jpg",
  finale:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/GoW_Reloaded_4K_ScreenShot_01op-69dd73f95d325-1024x576.jpg",
  characterMarcus:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/06/16_GoW_EDAY_MarcusScowl_4K-6a21e50068520-2048x1152-6a288c754c2ea.jpg",
  characterDom:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/06/12_GoW_EDAY_DomPayphone_4K-6a21e41c25f3a-2048x1152-6a288c85c9a92.jpg",
  characterDelta:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/04/gears-1-co-op-69d6e9d002b82.jpg",
  characterLocust:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/05/03_GoW_EDAY_Boomer_Final-6a17663e3da94-2048x1152.jpg",
  closing:
    "https://live.cdn.gearsofwar.com/gearsofwar/sites/3/2026/06/gears-eday-home-page-1024x576-6a14d78fe05aa-768x432-6a288cde6197b.jpg",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta
      name="description"
      content="Gears of War: Emergence. Una experiencia fan cinematográfica sobre el Día de la Emergencia y el Escuadrón Delta."
    />
    <title>Gears of War: Emergence — Emerge de las cenizas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="#inicio" aria-label="Gears of War, inicio">
          <span class="brand-mark">
            <img src="/images/gears-cog.png" alt="" width="332" height="400" />
          </span>
          <span class="brand-copy">GEARS<span>OF WAR</span></span>
        </a>

        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#guerra">La guerra</a>
          <a href="#personajes">Personajes</a>
          <a href="#armory">El arsenal</a>
          <a href="#threat-database">Amenazas</a>
        </nav>

        <span class="page-progress" aria-hidden="true">
          <span class="page-progress-fill"></span>
        </span>

        <details class="mobile-menu">
          <summary aria-label="Abrir menú" aria-expanded="false">
            <span></span><span></span>
          </summary>
          <nav aria-label="Navegación móvil">
            <a href="#guerra">La guerra</a>
            <a href="#personajes">Personajes</a>
            <a href="#armory">El arsenal</a>
            <a href="#threat-database">Amenazas</a>
            <a href="https://www.gearsofwar.com/en-us/" target="_blank" rel="noreferrer">
              Sitio oficial <span class="interface-icon"><ArrowIcon /></span>
            </a>
          </nav>
        </details>

        <a
          class="topbar-cta"
          href="https://www.gearsofwar.com/en-us/"
          target="_blank"
          rel="noreferrer"
        >
          SITIO OFICIAL <span class="interface-icon"><ArrowIcon /></span>
        </a>
      </header>

      <main>
        <section class="hero" id="inicio" aria-labelledby="hero-title">
          <div class="hero-art" aria-hidden="true">
            <canvas class="local-atmosphere" data-atmosphere="hero" aria-hidden="true"></canvas>
            <img
              src={artwork.hero}
              alt=""
              fetchpriority="high"
              width="2048"
              height="1152"
              decoding="async"
            />
            <div class="hero-art-shade"></div>
            <div class="hero-art-grain"></div>
            <div class="hero-coordinate">
              <span>IMULSION DETECTADA</span>
              <span class="coordinate-dot"></span>
              <span>31° 46' N — 106° 29' W</span>
            </div>
            <div class="art-frame art-frame-top"></div>
            <div class="art-frame art-frame-bottom"></div>
          </div>

          <div class="hero-copy">
            <p class="eyebrow"><span></span> ARTE PROMOCIONAL // GEARS OF WAR: E-DAY</p>
            <h1 id="hero-title">
              EMERGE<br />
              <span>DE LAS</span><br />
              <span class="title-accent">CENIZAS.</span>
            </h1>
            <div class="hero-detail">
              <span class="detail-rule"></span>
              <p>
                Sera cayó.<br />
                La humanidad resistió.<br />
                <strong>La guerra apenas comienza.</strong>
              </p>
            </div>
            <div class="hero-actions">
              <a class="button button-primary" href="#guerra">
                <span>ENTRA EN SERA</span>
                <ArrowIcon direction="south-east" class="button-icon" />
              </a>
              <a
                class="button button-ghost"
                href="https://www.gearsofwar.com/en-us/games/gears-of-war/"
                target="_blank"
                rel="noreferrer"
              >
                <ArrowIcon class="play-icon" />
                SITIO OFICIAL
              </a>
            </div>
          </div>

          <div class="hero-stamp" aria-label="Día de la Emergencia">
            <span>SERA</span>
            <span class="stamp-center">E-DAY</span>
            <span>EMERGENCE DAY</span>
          </div>

          <div class="hero-index" aria-hidden="true">
            <span>01</span>
            <span class="index-line"></span>
            <span>06</span>
          </div>

          <a class="scroll-cue" href="#guerra">
            <span>DESCIENDE A LA BATALLA</span>
            <span class="scroll-arrow"><ArrowIcon direction="down" /></span>
          </a>
        </section>

        <section class="war-sequence" id="guerra" aria-label="La guerra de Sera">
          <div class="sequence-frame">
            <canvas class="local-atmosphere" data-atmosphere="war" aria-hidden="true"></canvas>
            <div class="sequence-progress" aria-hidden="true">
              <span class="sequence-progress-fill"></span>
            </div>
            <article
              class="sequence-scene scene-awakening"
              data-scene="01"
              data-visual="panorama"
              aria-labelledby="scene-awakening-title"
            >
              <img
                class="scene-image"
                src={artwork.ruins}
                alt="Plaza de Sera en arte promocional oficial de Gears of War: E-Day"
                width="2048"
                height="1152"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> SERA // DÍA DE LA EMERGENCIA // ARTE E-DAY</p>
                <h2 id="scene-awakening-title">EL MUNDO<br />SE <em>QUEBRÓ.</em></h2>
                <p>De las entrañas de Sera surgió la Horda Locust. La civilización tenía las horas contadas.</p>
                <a class="text-link" href="https://www.gearsofwar.com/en-us/games/gears-of-war/" target="_blank" rel="noreferrer">
                  ARCHIVO DE LA GUERRA <span class="interface-icon"><ArrowIcon /></span>
                </a>
              </div>
              <span class="scene-coordinate" aria-hidden="true">31°46'N // EMERGENCIA</span>
            </article>
            <article
              class="sequence-scene scene-locust"
              data-scene="02"
              data-visual="breach"
              aria-labelledby="scene-locust-title"
            >
              <img
                class="scene-image"
                src={artwork.locust}
                alt="Drone Locust en arte promocional oficial de Gears of War: E-Day"
                width="2048"
                height="1152"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> CONTACTO HOSTIL // LOCUST // ARTE E-DAY</p>
                <h2 id="scene-locust-title">BAJO TIERRA.<br /><em>EN TODAS PARTES.</em></h2>
                <p>No conocen el miedo. No negocian. Y no dejarán de venir.</p>
                <span class="scene-tag">AMENAZA: EXTINCIÓN</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">CONTACTO VISUAL // ABRAN FUEGO</span>
            </article>
            <article
              class="sequence-scene scene-squad"
              data-scene="03"
              data-visual="formation"
              id="escuadron"
              aria-labelledby="scene-squad-title"
            >
              <img
                class="scene-image"
                src={artwork.squad}
                alt="Soldados del escuadrón Bravo en arte promocional oficial de Gears of War: E-Day"
                width="2048"
                height="1152"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> GEARS OF WAR: E-DAY // ESCUADRÓN BRAVO</p>
                <h2 id="scene-squad-title">CUANDO TODO<br /><em>SE DERRUMBA.</em></h2>
                <p>En la víspera de la Emergencia, el escuadrón Bravo se prepara para defender su hogar.</p>
                <span class="scene-tag">ARTE PROMOCIONAL E-DAY // UNIDAD BRAVO</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">BRAVO SQUAD // READY</span>
            </article>
            <article
              class="sequence-scene scene-arsenal"
              data-scene="04"
              data-visual="containment"
              aria-labelledby="scene-arsenal-title"
            >
              <img
                class="scene-image"
                src={artwork.combat}
                alt="Un Drone Locust forcejea con un soldado en una imagen promocional de Gears of War: E-Day"
                width="2048"
                height="1152"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> CONTACTO HOSTIL // CONTENCIÓN</p>
                <h2 id="scene-arsenal-title">NO VIENEN<br /><em>DE UNO EN UNO.</em></h2>
                <p>En el Día de la Emergencia, cada contacto puede convertirse en una lucha por sobrevivir.</p>
                <span class="scene-tag">AMENAZA ACTIVA // MANTENER LA LÍNEA</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">MANTENER POSICIÓN // RECARGAR</span>
            </article>
            <article
              class="sequence-scene scene-ruins"
              data-scene="05"
              data-visual="ashfall"
              aria-labelledby="scene-ruins-title"
            >
              <img
                class="scene-image"
                src={artwork.estate}
                alt="La finca Fenix en una captura promocional oficial de Gears of War: Reloaded"
                width="1024"
                height="576"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> SERA // MUNDO EN RUINAS</p>
                <h2 id="scene-ruins-title">TODO LO QUE<br />QUEDA ES <em>LUCHAR.</em></h2>
                <p>Calles vacías. Ciudades caídas. Una última oportunidad para salvar lo que queda.</p>
                <span class="scene-tag">NO HAY REFUERZOS // MANTÉN LA LÍNEA</span>
              </div>
              <span class="scene-coordinate" aria-hidden="true">FENIX ESTATE // SECTOR 04</span>
            </article>
            <article
              class="sequence-scene scene-finale"
              data-scene="06"
              data-visual="last-stand"
              aria-labelledby="scene-finale-title"
            >
              <img
                class="scene-image"
                src={artwork.finale}
                alt="Captura promocional oficial de Gears of War: Reloaded"
                width="1024"
                height="576"
                loading="eager"
                decoding="async"
              />
              <div class="scene-wash"></div>
              <div class="scene-copy">
                <p class="eyebrow"><span></span> ESTA ES NUESTRA ÚLTIMA LÍNEA</p>
                <h2 id="scene-finale-title">NO NOS<br /><em>RENDIMOS.</em></h2>
                <p>La humanidad todavía respira. Haz que cada bala cuente.</p>
                <a class="button button-primary" href="https://www.gearsofwar.com/en-us/games/gears-of-war/" target="_blank" rel="noreferrer">
                  <span>DESCUBRE GEARS OF WAR</span>
                  <ArrowIcon class="button-icon" />
                </a>
              </div>
              <span class="scene-coordinate" aria-hidden="true">DELTA OUT // STAY ALIVE</span>
            </article>
            <nav class="sequence-nav" aria-label="Escenas de la campaña">
              <a href="#guerra" data-scene-link="0" aria-label="Escena 1: El despertar" aria-current="step">01</a>
              <a href="#guerra" data-scene-link="1" aria-label="Escena 2: La amenaza Locust">02</a>
              <a href="#guerra" data-scene-link="2" aria-label="Escena 3: Delta Squad">03</a>
              <a href="#guerra" data-scene-link="3" aria-label="Escena 4: El arsenal">04</a>
              <a href="#guerra" data-scene-link="4" aria-label="Escena 5: Sera en ruinas">05</a>
              <a href="#guerra" data-scene-link="5" aria-label="Escena 6: La última línea">06</a>
            </nav>
            <span class="sequence-hint" aria-hidden="true">DESPLÁZATE PARA AVANZAR</span>
          </div>
        </section>

        <section class="character-section" id="personajes" aria-labelledby="characters-title">
          <header class="editorial-heading section-wrap reveal">
            <p class="eyebrow"><span></span> ARCHIVO VISUAL // GEARS OF WAR</p>
            <h2 id="characters-title">LOS QUE<br /><em>NO CEDEN.</em></h2>
            <p>
              Retratos promocionales de Marcus y Dom en E-Day, junto al Escuadrón Delta y sus
              enemigos en Gears of War. Las imágenes de E-Day no ilustran la campaña original.
            </p>
          </header>

          <div class="character-track" data-editorial-track>
            <div class="character-stage" data-editorial-stage>
              <canvas class="local-atmosphere" data-atmosphere="characters" aria-hidden="true"></canvas>
              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="command"
                aria-labelledby="character-marcus-title"
              >
                <img
                  class="editorial-image"
                  src={artwork.characterMarcus}
                  alt="Marcus Fenix en arte promocional oficial de Gears of War: E-Day"
                  width="2048"
                  height="1152"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> SOLDADO // COG</p>
                  <h3 id="character-marcus-title">MARCUS<br /><em>FENIX.</em></h3>
                  <p>
                    Un soldado de la CGO cuyo temple y voluntad de resistir lo convierten en una
                    figura central para quienes luchan junto a él.
                  </p>
                  <span class="editorial-caption">ARTE PROMOCIONAL OFICIAL // GEARS OF WAR: E-DAY</span>
                </div>
                <span class="editorial-coordinate">01 // EL LÍDER</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="brotherhood"
                aria-labelledby="character-dom-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.characterDom}
                  alt="Dominic Santiago en arte promocional oficial de Gears of War: E-Day"
                  width="2048"
                  height="1152"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> SOLDADO // CGO</p>
                  <h3 id="character-dom-title">DOMINIC<br /><em>SANTIAGO.</em></h3>
                  <p>
                    Leal y decidido, Dom lucha por proteger a los suyos. Su amistad con Marcus
                    precede a la guerra y sostiene a ambos en los momentos más oscuros.
                  </p>
                  <span class="editorial-caption">ARTE PROMOCIONAL OFICIAL // GEARS OF WAR: E-DAY</span>
                </div>
                <span class="editorial-coordinate">02 // EL COMPAÑERO</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="brotherhood"
                aria-labelledby="character-delta-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.characterDelta}
                  alt="Marcus Fenix, Dominic Santiago, Augustus Cole y Damon Baird en una imagen promocional oficial de Gears of War"
                  width="1024"
                  height="576"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> CGO // ESCUADRÓN DELTA</p>
                  <h3 id="character-delta-title">NADIE<br /><em>LUCHA SOLO.</em></h3>
                  <p>
                    Marcus, Dom, Cole y Baird: cuatro soldados con habilidades distintas, unidos
                    por la confianza que exige cada misión.
                  </p>
                  <span class="editorial-caption">IMAGEN PROMOCIONAL OFICIAL // GEARS OF WAR</span>
                </div>
                <span class="editorial-coordinate">03 // EQUIPO DELTA</span>
              </article>

              <article
                class="editorial-panel character-panel"
                data-editorial-slide
                data-visual="horde"
                aria-labelledby="character-locust-title"
                aria-hidden="true"
              >
                <img
                  class="editorial-image"
                  src={artwork.characterLocust}
                  alt="Un Boomer Locust en arte promocional oficial de Gears of War: E-Day"
                  width="2048"
                  height="1152"
                  loading="lazy"
                  decoding="async"
                />
                <div class="editorial-wash"></div>
                <div class="editorial-copy">
                  <p class="eyebrow"><span></span> ENEMIGO // LA HORDA</p>
                  <h3 id="character-locust-title">LA HORDA<br /><em>LOCUST.</em></h3>
                  <p>
                    Los Locust emergen de las profundidades en el Día de la Emergencia. Su fuerza
                    convierte cada encuentro en una lucha desesperada por sobrevivir.
                  </p>
                  <span class="editorial-caption">ARTE PROMOCIONAL OFICIAL // GEARS OF WAR: E-DAY</span>
                </div>
                <span class="editorial-coordinate">04 // BAJO TIERRA</span>
              </article>

              <nav class="editorial-nav" aria-label="Archivo de personajes">
                <a href="#personajes" data-editorial-link="0" aria-label="Marcus Fenix" aria-current="step">01</a>
                <a href="#personajes" data-editorial-link="1" aria-label="Dominic Santiago">02</a>
                <a href="#personajes" data-editorial-link="2" aria-label="Escuadrón Delta">03</a>
                <a href="#personajes" data-editorial-link="3" aria-label="La Horda Locust">04</a>
              </nav>
              <span class="editorial-hint" aria-hidden="true">DESPLÁZATE PARA CONOCERLOS</span>
            </div>
          </div>
        </section>

        <ArmorySection />
        <ThreatDatabaseSection />

        <section class="aftermath" aria-labelledby="aftermath-title">
          <canvas class="local-atmosphere" data-atmosphere="aftermath" aria-hidden="true"></canvas>
          <div
            class="aftermath-art"
            style={`--aftermath-art: url("${artwork.closing}")`}
            aria-hidden="true"
          ></div>
          <div class="aftermath-copy section-wrap reveal">
            <p class="eyebrow"><span></span> POR LOS CAÍDOS. POR LOS QUE QUEDAN.</p>
            <h2 id="aftermath-title">LA GUERRA NO<br />TERMINA <em>AQUÍ.</em></h2>
            <p>La batalla por Sera continúa. Vuelve al frente con la saga que cambió para siempre la guerra en los videojuegos.</p>
            <a class="button button-primary" href="https://www.gearsofwar.com/en-us/" target="_blank" rel="noreferrer">
              <span>VISITA EL SITIO OFICIAL</span>
              <ArrowIcon class="button-icon" />
            </a>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="footer-main section-wrap">
          <div class="footer-identity">
            <a class="brand footer-brand" href="#inicio" aria-label="Volver al inicio">
              <span class="brand-mark">
                <img src="/images/gears-cog.png" alt="" width="332" height="400" />
              </span>
              <span class="brand-copy">GEARS<span>OF WAR</span></span>
            </a>
            <p class="footer-mission">ESTO ES SERA.<br /><strong>NO HAY VUELTA ATRÁS.</strong></p>
            <p class="footer-description">
              Un archivo visual hecho por fans en honor a la trilogía clásica de Gears of War.
            </p>
          </div>
          <nav class="footer-explore" aria-label="Explorar la experiencia">
            <span class="footer-label">EXPLORACIÓN</span>
            <a href="#guerra">La guerra</a>
            <a href="#personajes">Escuadrón Delta</a>
            <a href="#armory">Arsenal</a>
            <a href="#threat-database">Base de amenazas</a>
          </nav>
          <div class="footer-outbound">
            <span class="footer-label">TRANSMISIÓN EXTERNA</span>
            <a
              class="footer-official"
              href="https://www.gearsofwar.com/en-us/games/gears-of-war/"
              target="_blank"
              rel="noreferrer"
            >GEARS OF WAR OFICIAL <span class="interface-icon"><ArrowIcon /></span></a>
            <span class="footer-signal"><i></i> CANAL CGO // ACTIVO</span>
          </div>
        </div>
        <div class="footer-bottom section-wrap">
          <span class="footer-legal">
